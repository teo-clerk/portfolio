{
  "name": "terminal-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:cv": "node scripts/generate-cv.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:vercel": "node scripts/check-vercel.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "npm run generate:cv",
    "dev": "vite",
    "prebuild": "npm run check:vercel && npm test && npm run generate:cv && npm run check:api",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "path-to-regexp": "6.3.0",
    "vite": "^7.2.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
